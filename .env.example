# zoom-seaweedfs environment example
# Local:  cp .env.example .env   (then fill in real values)
# Coolify: set these as Environment Variables on the resource —
#          docker-compose.yaml interpolates them at parse time.

# S3 credentials (admin identity in /config.json, used by seaweedfs-master)
SERVICE_USER_S3=your_s3_access_key
SERVICE_PASSWORD_S3=your_s3_secret_key

# Admin UI login (weed admin; empty password = auth disabled, no login form)
SERVICE_USER_ADMIN=admin
SERVICE_PASSWORD_ADMIN=changeme
